# --- Required ---
MONGO_URI=
# Lock-screen passcode. Use something long; it's the only thing protecting the app.
APP_PASSCODE=
# 32+ random chars, required in production: openssl rand -hex 32
SESSION_SECRET=

# --- Hosting ---
# Comma-separated origins allowed to call the API directly (CORS).
FRONTEND_ORIGIN=https://winterarc.benedictisaac.dev
# Proxy hops in front of the server: 1 = Render only, 2 = Vercel -> Render
TRUST_PROXY=1

# --- Drop file storage (AWS S3 or any S3-compatible store) ---
S3_DROP_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# us-east-1 for AWS, "auto" for Cloudflare R2
S3_REGION=
# Leave empty for AWS. R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Leave empty: the frontend calls /api on its own origin (Vercel proxies it).
VITE_API_URL=
