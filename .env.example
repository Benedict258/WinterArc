# --- Required ---
MONGO_URI=
# Lock-screen passcode. Use something long; it's the only thing protecting the app.
APP_PASSCODE=
# 32+ random chars, required in production: openssl rand -hex 32
SESSION_SECRET=

# --- Hosting ---
# Comma-separated origins allowed to call the API directly (CORS).
FRONTEND_ORIGIN=https://winterarc.benedictisaac.dev
# Proxy hops in front of the server: 1 = Render only, 2 = Vercel -> Render
TRUST_PROXY=1

# --- Drop file storage: Backblaze B2 (S3-compatible API) ---
# See DEPLOYMENT.md §4, then check with: npm run storage:check
S3_DROP_BUCKET=winterarc-drop
# B2 application keyID / applicationKey
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Region and endpoint from the bucket card, e.g. us-west-004
S3_REGION=
S3_ENDPOINT=https://s3.<region>.backblazeb2.com
S3_FORCE_PATH_STYLE=false


# --- Push notifications (laptop/browser) ---
# Generate once with: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for the keep-alive/scheduler pinger: GET /api/cron/tick?key=<CRON_SECRET>
CRON_SECRET=

# --- Google Calendar sync (optional) ---
# Create an OAuth client (type: Web application) in Google Cloud Console, enable the
# Google Calendar API, and add the redirect URI below. See DEPLOYMENT.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to <FRONTEND_ORIGIN>/api/calendar/callback
GOOGLE_REDIRECT_URI=
