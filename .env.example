# --- Required ---
MONGO_URI=
# 32+ random chars, required in production: openssl rand -hex 32
SESSION_SECRET=

# --- Hosting ---
# Web app address(es): CORS and the links inside emails
FRONTEND_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
# Proxy hops in front of the server: 1 = Render only, 2 = Vercel -> Render
TRUST_PROXY=1

# --- Accounts ---
# Beta: sign-up needs an invite code (create codes with: npm run invite:create -- --count 5)
INVITE_REQUIRED=true
# Comma-separated emails that become admins once verified
ADMIN_EMAIL=
# Contact address shown on the Privacy Policy and Terms pages (defaults to ADMIN_EMAIL)
SUPPORT_EMAIL=
# Dev only: keep sessions in memory (needed for MongoDB-compatible servers without TTL indexes)
# SESSION_STORE=memory

# --- Email (Resend). Without a key, emails are printed to the server console ---
RESEND_API_KEY=
EMAIL_FROM=WinterArc <onboarding@resend.dev>

# --- "Continue with Google" and Calendar sync (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to <FRONTEND_ORIGIN>/api/calendar/callback
GOOGLE_REDIRECT_URI=

# --- Push notifications ---
# Generate once with: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret for the keep-alive/scheduler pinger: GET /api/cron/tick?key=<CRON_SECRET>
CRON_SECRET=

# --- Drop file storage: Backblaze B2 (S3-compatible API) ---
S3_DROP_BUCKET=winterarc-drop
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=https://s3.<region>.backblazeb2.com
S3_FORCE_PATH_STYLE=false

# --- Tests ---
# Integration tests need a MongoDB-compatible server (skipped if none is reachable)
# TEST_MONGO_URI=mongodb://127.0.0.1:27017

# AI assistant (optional). Works with any OpenAI-compatible provider. Without a key the Assistant page says it isn't switched on.
# AI_PROVIDER: groq (default) | nvidia | custom
AI_PROVIDER=groq
GROQ_API_KEY=
# NVIDIA NIM (build.nvidia.com): AI_PROVIDER=nvidia and NVIDIA_API_KEY. Its free tier is for development, not production.
NVIDIA_API_KEY=
# custom: AI_PROVIDER=custom with AI_API_KEY, AI_BASE_URL (e.g. https://host/v1) and AI_MODEL
AI_API_KEY=
AI_BASE_URL=
# Defaults: groq openai/gpt-oss-120b, nvidia meta/llama-3.3-70b-instruct. The model must support tool calling.
AI_MODEL=
# Tokens each person may use per month / per day, and chat messages per hour
AI_MONTHLY_TOKENS=300000
AI_DAILY_TOKENS=100000
AI_REQUESTS_PER_HOUR=30

# Paid plans (optional), via Paystack (paystack.com). Without these the Plan page says payments aren't switched on.
PAYSTACK_SECRET_KEY=
# Amounts are in the currency's smallest unit (kobo for NGN: 500000 = ₦5,000)
BILLING_CURRENCY=NGN
PRO_PRICE_MONTHLY_MINOR=
# Defaults to ten months' price for a year
PRO_PRICE_YEARLY_MINOR=

# Shown on the Privacy Policy and Terms: who runs WinterArc, and whose law governs the terms
LEGAL_NAME=
LEGAL_JURISDICTION=
